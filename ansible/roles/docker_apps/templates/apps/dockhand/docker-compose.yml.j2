services:
  dockhand:
    image: {{ dockhand_image | to_json }}
    container_name: dockhand
    restart: unless-stopped
    environment:
      DATA_DIR: {{ (docker_base_dir ~ '/dockhand/data') | to_json }}
    ports:
      - "3000:3000"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      # Identical host/container paths preserve relative mounts in adopted stacks.
      - {{ (docker_base_dir ~ ':' ~ docker_base_dir) | to_json }}
    networks:
      - proxy
    labels:
      - "traefik.enable=trus
      - "traefik.http.routers.dockhand.rule=Host(`dockhand.{{ SECRET_DOMAIN }}`)"
      - "traefik.http.routers.dockhand.entrypoints=websecure"
      - "traefik.http.routers.dockhand.tls.certresolver=ionos"
      - "traefik.http.routers.dockhand.middlewares=traefik-auth@docker"
      - "traefik.http.services.dockhand.loadbalancer.server.port=3000"
      - "traefik.docker.network=proxy"
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

networks:
  proxy:
    external: true
